# Compose
COMPOSE_PROJECT_NAME=grid-repair
# 端口映射
FRONTEND_PORT=20104
BACKEND_PORT=21104
DB_PORT=33060

# 数据库（backend 通过服务名 db 连接 3306）
DB_HOST=db
DB_PORT=3306
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# 后端
JWT_SECRET=local-dev-secret
JWT_EXPIRES_IN=12h
NODE_ENV=production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
