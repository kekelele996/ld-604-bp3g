# ============================================================================
# grid-repair 电力配网抢修工单系统 - 环境变量样例
# 用法：cp .env.example .env && docker compose up -d
# ============================================================================

# Compose 项目名（容器名/卷名前缀，必须为 grid-repair）
COMPOSE_PROJECT_NAME=grid-repair

# 宿主机端口映射
FRONTEND_PORT=20104
BACKEND_PORT=21104
DB_PORT=33060

# MySQL 8.0 数据库凭据
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=app_password

# 后端 JWT 密钥（生产请修改）
JWT_SECRET=local-dev-secret

# 接口限流：每 IP 每窗口最大请求数（并发派工联调可放宽）
RATE_LIMIT_MAX=600

# 后端持久化驱动（compose 内固定为 prisma=MySQL；本地裸跑可用 memory）
# DB_DRIVER=prisma
